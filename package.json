{
  "name": "phoenix-solana",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/solana-dashboard"
  ],
  "scripts": {
    "dev": "npm run dev -w @phoenix/dashboard",
    "build": "npm run build -w @phoenix/dashboard",
    "typecheck": "npm run typecheck -w @phoenix/dashboard",
    "test": "npm run test -w @phoenix/dashboard",
    "test:program": "cargo test -p phoenix-solana-program",
    "build:production": "node scripts/build-production.mjs",
    "test:production": "node --test apps/production/server/integration.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
