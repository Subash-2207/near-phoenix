# Explicit testnet read-only RPC configuration.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Set public contract and task identifiers separately after testnet deployment.
# NEXT_PUBLIC_PHOENIX_CORE_ID=
# NEXT_PUBLIC_REWIND_VAULT_ID=
# NEXT_PUBLIC_PHOENIX_AGENT_ID=
# NEXT_PUBLIC_PHOENIX_TASK_ID=

# Optional bounded wallet action review. Set true only after testnet deployment.
PHOENIX_ENABLE_WALLET_ACTIONS=false
# PHOENIX_CORE_ID=your-reviewed-contract.testnet
# PHOENIX_CORE_CODE_HASH=exact-deployed-code-hash
# The signer must be the on-chain operator for heartbeat.
